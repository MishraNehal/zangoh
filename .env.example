LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-required
LLM_MODEL=your-open-source-model
API_BASE_URL=http://localhost:8000
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=8501
VECTOR_DB_PATH=.data/vector_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_COLLECTION=customer-support
RAG_TOP_K=3

# Voice enhancement (mid-session requirement)
# STT: Groq-hosted Whisper, called directly over HTTP (no extra SDK).
# Leave STT_API_KEY blank to reuse LLM_API_KEY -- both are the same Groq
# account by default. Set STT_API_KEY only if you want to separate them.
STT_MODEL=whisper-large-v3-turbo
STT_API_KEY=
# TTS: Microsoft Edge neural voices via the free edge-tts package (no key).
TTS_VOICE=en-US-AriaNeural
